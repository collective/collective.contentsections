<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    >

  <adapter
      factory=".base.SectionAddView"
      provides="zope.publisher.interfaces.browser.IBrowserPage"
      for="..pages.base.IPage
           ..interfaces.IBrowserLayer
           plone.dexterity.interfaces.IDexterityFTI"
      />
  <class class=".base.SectionAddView">
    <require
        permission="cmf.AddPortalContent"
        interface="zope.publisher.interfaces.browser.IBrowserPage"
        />
  </class>

  <subscriber
      for=".base.ISection
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".base.reindex_parent_page"
      />

  <subscriber
      for=".base.ISection
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".base.reindex_parent_page"
      />

  <subscriber
      for=".base.ISection
           zope.lifecycleevent.interfaces.IObjectRemovedEvent"
      handler=".base.reindex_parent_page"
      />

  <include package=".cards" />
  <include package=".collection" />
  <include package=".contacts" />
  <include package=".files" />
  <include package=".html" />
  <include package=".images" />
  <include package=".links" />
  <include package=".locations" />
  <include package=".query" />
  <include package=".selection" />
  <include package=".text" />




</configure>
