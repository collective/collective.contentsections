<html metal:use-macro="context/@@main_template/macros/master">
  <metal:main fill-slot="main">

    <metal:content-core define-macro="content-core">
      <?python
        alignment = context.lead_image_alignment
        vertical = alignment in ("top", "bottom")
        has_image = bool(context.image)
        lead_image_cols = context.lead_image_width

        image_col = "col-12" if vertical else f"col-lg-{lead_image_cols}"
        text_col = "col-12" if vertical else f"col-lg-{12 - lead_image_cols}"
        image_order = "order-1" if alignment in ("left", "top") else "order-2"
        text_order = "order-2" if alignment in ("left", "top") else "order-1"
        row_class = "row align-items-center g-4 flex-column" if vertical else "row align-items-center g-4"
        figure_class = "mx-auto d-block mb-0" if vertical else "mb-0"
        lead_image_max_pixels = lead_image_cols * 100 # TODO: This is a temporary hack to have full width images in top and bottom alignment on mobile.
        figure_style = f"max-width: {lead_image_max_pixels}px;" if vertical else ""
        ?>
      <div class="${row_class}">
        <div class="${image_col} ${image_order}"
             tal:condition="python: has_image"
        >
          <figure class="${figure_class}"
                  style="${figure_style}"
          >
            <img class="figure-image img-fluid"
                 tal:attributes="
                   src string:${context/absolute_url}/@@images/image/${view/lead_image_scale};
                 "
            />
            <figcaption class="figure-caption"
                        style="display:block"
                        tal:condition="context/image_caption"
            >
              ${context/image_caption}
            </figcaption>
          </figure>
        </div>
        <div class="${text_col} ${text_order} text"
             tal:condition="python: has_image"
             tal:content="structure context/text/output | nothing"
        ></div>
        <div class="col-12 text"
             tal:condition="python: not has_image"
             tal:content="structure context/text/output | nothing"
        ></div>
      </div>
    </metal:content-core>

  </metal:main>
</html>
