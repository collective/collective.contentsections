<html metal:use-macro="context/@@main_template/macros/master">
  <metal:main fill-slot="main">
    <metal:content-core define-macro="content-core">
      <?python
        group_size_for_xl = context.group_size
        group_size_for_lg = min(group_size_for_xl, 3)
      ?>
      <div class="row row-cols-1 row-cols-lg-${group_size_for_lg} row-cols-xl-${group_size_for_xl} g-4 justify-content-center">
        <div class="col"
             tal:repeat="item view/items"
        >
          <metal:block use-macro="context/@@collective_contentsections_utils/macros/card" />
        </div>
      </div>
      <div class="section-more-link"
           tal:condition="view/more_link_text | nothing"
      >
        <a href="${view/more_link_url}">${view/more_link_text}</a>
      </div>
    </metal:content-core>
  </metal:main>
</html>
